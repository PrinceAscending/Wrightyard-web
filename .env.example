# Local and production environment for the Wrightyard website.
# Copy to .env.local for local work. Never commit real values.

# Public origin of the site. Used for OAuth redirects, metadata, and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord OAuth application.
DISCORD_CLIENT_ID=1566784935342252032
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Bot credentials. The site uses these for guild snapshots, member checks,
# and announcements. The gateway process uses the same token separately.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_GUILD_ID=1566778873985892442
OWNER_ID=971329961313046578

# #announcements
ANNOUNCEMENTS_CHANNEL_ID=1566786878416486500

# 32+ byte random secrets.
# AUTH_SECRET signs the session cookie (openssl rand -hex 48).
# BOT_HEARTBEAT_SECRET signs bot heartbeats (must match the bot host).
AUTH_SECRET=replace-with-64-char-random
BOT_HEARTBEAT_SECRET=replace-with-64-char-random

# Durable shared state, job book, dispatch archive, and ticket ledger.
# Create a MongoDB Atlas cluster, add a database user, and paste the SRV URI
# here. Never commit the real URI. The database user only needs readWrite on
# this database.
MONGODB_URI=mongodb+srv://wrightyard:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wrightyard

# Optional Upstash Redis fallback. MongoDB is primary; these are only used if
# MongoDB is unavailable. Leave empty unless a fallback already exists.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
