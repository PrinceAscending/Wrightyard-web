# Wrightyard bot environment.
# Copy to .env.local (local development) or set these in the hosting dashboard.
# Never commit real values.

# Discord application credentials. The client ID is public; the token is not.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=1566784935342252032

# The single guild this deployment serves.
DISCORD_GUILD_ID=1566778873985892442

# The only Discord user allowed to run /admin. This is a user ID, not a role.
OWNER_ID=971329961313046578

# Public site origin. Must match NEXT_PUBLIC_SITE_URL on the website.
# The heartbeat is disabled while this is the example placeholder.
SITE_URL=https://your-site.vercel.app

# Shared HMAC secret. Must be the exact same value as the website's
# BOT_HEARTBEAT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BOT_HEARTBEAT_SECRET=replace-with-64-char-random

# Optional channel and role IDs. Empty values disable the related feature or
# fall back to a channel named #open-a-ticket.
ANNOUNCEMENTS_CHANNEL_ID=1566786878416486500
TICKET_PANEL_CHANNEL_ID=1566786959937110218
TICKET_LOG_CHANNEL_ID=1566787034545262783

# Comma-separated staff role IDs. Ticket opening refuses while this is empty.
STAFF_ROLE_IDS=1566787080439337103,1566787076458815621

# Optional existing category for private ticket channels. When empty, the bot
# uses or creates a category named "Tickets".
TICKET_CATEGORY_ID=

# Shared MongoDB Atlas database. The bot writes durable ticket history here and
# the website reads it for the owner's ledger and member files. Use the same
# values as the website, and never commit the real URI.
MONGODB_URI=mongodb+srv://wrightyard:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wrightyard

# Port for the health server. Railway and Fly route to this internal port.
PORT=8080
