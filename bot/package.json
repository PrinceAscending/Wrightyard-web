{
  "name": "wrightyard-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Wrightyard yard bot: status, stats, tickets, and a quiet heartbeat.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "deploy-commands:source": "tsx src/deploy-commands.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
